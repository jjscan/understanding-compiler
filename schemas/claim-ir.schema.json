{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibelabs.kr/schemas/understanding-compiler/claim-ir.schema.json",
  "title": "Claim IR",
  "description": "Understanding Compiler의 중간 표현. 원문 단위(source.units) → 주장(claims) → 시각 요소(visuals)·요약(summary)·추론(inferences)이 모두 ID로 연결된다.",
  "type": "object",
  "required": [
    "version",
    "meta",
    "source",
    "claims"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "mode",
        "source_path"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "understand",
            "inspect",
            "visualize"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "design-doc",
            "research-report",
            "ai-answer",
            "other"
          ],
          "description": "테스트 케이스 A/B/C에 대응. 라우팅 기본값 판단에 쓴다."
        },
        "created": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "external_verification": {
          "type": "boolean",
          "description": "이번 실행에서 웹/파일 등 외부 확인을 수행했는가. false면 verified Claim이 있을 수 없다."
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "text",
              "line_start",
              "line_end"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^P\\d{2,}$"
              },
              "kind": {
                "enum": [
                  "heading",
                  "paragraph",
                  "list-item",
                  "table-row",
                  "quote",
                  "code"
                ]
              },
              "text": {
                "type": "string"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "section": {
                "type": "string",
                "description": "가장 가까운 상위 제목"
              },
              "ordered": {
                "type": "boolean",
                "description": "list-item 이 번호 목록(1. 2.)인가 — 원문이 순서를 명시했는지 판단 근거"
              },
              "index": {
                "type": "integer",
                "description": "번호 목록의 원래 번호"
              },
              "origin": {
                "type": "string",
                "pattern": "^image:\\d+$",
                "description": "이미지에서 옮겨 적은 단위 (source-capture.md)"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "unit",
              "reason"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "^P\\d{2,}$"
              },
              "reason": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E\\d{2,}$"
          },
          "name": {
            "type": "string",
            "description": "Claim 문장에서 쓰는 대표 이름"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "원문에서 같은 대상을 부른 다른 이름"
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claimId"
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "type",
          "source_text",
          "source_location",
          "evidence",
          "confidence",
          "visualization"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/claimId"
          },
          "text": {
            "type": "string",
            "minLength": 2,
            "description": "STE 원칙으로 정규화한 한 문장"
          },
          "type": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "fact",
                "definition",
                "procedure",
                "relationship",
                "comparison",
                "temporal",
                "causal",
                "conditional",
                "quantitative",
                "opinion",
                "prediction",
                "uncertain"
              ]
            }
          },
          "source_text": {
            "type": "string",
            "minLength": 2,
            "description": "source_location 단위에서 그대로 복사한 연속 구간"
          },
          "source_location": {
            "type": "string",
            "pattern": "^P\\d{2,}$"
          },
          "evidence": {
            "enum": [
              "verified",
              "supported",
              "source-needed",
              "model-claim",
              "inference",
              "opinion",
              "uncertain",
              "conflicting"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "description": "supported일 때 원문 안의 근거 — 원문 문구를 그대로 복사하거나 근거가 있는 원문 단위 ID(P..)를 가리킨다"
          },
          "confidence": {
            "enum": [
              "unknown",
              "low",
              "medium",
              "high"
            ]
          },
          "visualization": {
            "enum": [
              "text",
              "flow",
              "diagram",
              "table",
              "animation"
            ]
          },
          "importance": {
            "enum": [
              "core",
              "supporting",
              "detail"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "unsupported",
                "overgeneralization",
                "vague",
                "fact-inference-mix",
                "naming-drift",
                "missing-condition",
                "number-unclear",
                "hedge-dropped-in-source",
                "compound-split",
                "outdated-risk",
                "overclaim"
              ]
            }
          },
          "review_note": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E\\d{2,}$"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "time": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claimId"
            }
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claimId"
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "method",
              "reference",
              "result",
              "checked_at"
            ],
            "properties": {
              "method": {
                "enum": [
                  "web",
                  "file",
                  "user-provided",
                  "tool-run"
                ]
              },
              "reference": {
                "type": "string"
              },
              "checked_at": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "confirmed",
                  "contradicted",
                  "not-found"
                ]
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "claims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d{2,}$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/edgeKind"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/claimId"
            }
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "text",
          "based_on",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^I\\d{2,}$"
          },
          "label": {
            "enum": [
              "INFERENCE",
              "INTERPRETATION"
            ]
          },
          "text": {
            "type": "string"
          },
          "based_on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/claimId"
            }
          },
          "reason": {
            "type": "string",
            "description": "왜 이 해석이 이해에 필요한가"
          }
        }
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V\\d{2,}$"
          },
          "kind": {
            "enum": [
              "diagram",
              "flow",
              "table",
              "animation"
            ]
          },
          "title": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "TD",
              "LR"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "claims"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "label": {
                  "type": "string"
                },
                "entity": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "남은 경고가 의도된 것이면 이유"
                },
                "group": {
                  "type": "string"
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/claimId"
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "kind"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "kind": {
                  "$ref": "#/$defs/edgeKind"
                },
                "label": {
                  "type": "string"
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/claimId"
                  }
                },
                "relation": {
                  "type": "string",
                  "pattern": "^R\\d{2,}$"
                },
                "inferred": {
                  "type": "boolean"
                },
                "inference": {
                  "type": "string",
                  "pattern": "^I\\d{2,}$"
                },
                "note": {
                  "type": "string",
                  "description": "남은 경고가 의도된 것이면 이유"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "claims"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/claimId"
                  }
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cells",
                "claims"
              ],
              "properties": {
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/claimId"
                  }
                }
              }
            }
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "caption",
                "motion",
                "claims"
              ],
              "properties": {
                "caption": {
                  "type": "string",
                  "description": "화면에 띄울 문장 = 내레이션과 동일"
                },
                "motion": {
                  "type": "string",
                  "description": "무엇이 움직이는가(상태 변화)"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 60
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/claimId"
                  }
                }
              }
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claimId"
            },
            "description": "visual 전체가 다루는 Claim(자동 계산 가능)"
          }
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "claims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2,}$"
          },
          "text": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/claimId"
            }
          },
          "note": {
            "type": "string",
            "description": "남은 경고가 의도된 것이면 이유"
          }
        }
      }
    },
    "narrative": {
      "type": "object",
      "description": "읽기 페이지(이해용 설명 본문). understand·visualize 모드에서 필수.",
      "required": [
        "headline",
        "sections"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/sentence",
          "description": "이 글이 말하는 것을 한두 문장으로"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^N\\d{2,}$"
              },
              "title": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "text",
                        "points",
                        "visual",
                        "example",
                        "callout"
                      ]
                    },
                    "sentences": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/sentence"
                      }
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^V\\d{2,}$"
                    },
                    "caption": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string",
                      "description": "example 블록 제목 (예: '고쳐 쓰기 전 → 후', '따라 해보기')"
                    },
                    "items": {
                      "type": "array",
                      "description": "example 블록: 원문(또는 context)에서 그대로 옮긴 인용들",
                      "items": {
                        "type": "object",
                        "required": [
                          "quote"
                        ],
                        "properties": {
                          "quote": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "claims": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/claimId"
                            }
                          },
                          "context": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^K\\d{2,}$"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "array",
      "description": "원문 밖 배경 설명(CONTEXT). 이해에 필요하지만 원문에 없는 용어·배경. 원문 주장과 섞지 않는다.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "term",
          "text",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^K\\d{2,}$"
          },
          "term": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "왜 이 배경이 이해에 필요한가"
          },
          "reference": {
            "type": "string",
            "description": "외부 확인을 했다면 출처 URL·문헌"
          }
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_to_claim": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-reviewed",
                "needs-revision",
                "reviewed"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "reviewed",
                      "needs-revision"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "reviewer",
                  "method",
                  "checked_at",
                  "notes"
                ]
              }
            }
          ]
        },
        "claim_to_narrative": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-reviewed",
                "needs-revision",
                "reviewed"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "reviewed",
                      "needs-revision"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "reviewer",
                  "method",
                  "checked_at",
                  "notes"
                ]
              }
            }
          ]
        },
        "coverage": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-reviewed",
                "needs-revision",
                "reviewed"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "reviewed",
                      "needs-revision"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "reviewer",
                  "method",
                  "checked_at",
                  "notes"
                ]
              }
            }
          ]
        },
        "reader_flow": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-reviewed",
                "needs-revision",
                "reviewed"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "reviewed",
                      "needs-revision"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "reviewer",
                  "method",
                  "checked_at",
                  "notes"
                ]
              }
            }
          ]
        }
      }
    },
    "explanation_plan": {
      "type": "object",
      "required": [
        "audience",
        "goal",
        "opening_question",
        "depth",
        "questions"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "opening_question": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "question",
              "claims"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^C\\d{2,}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "claimId": {
      "type": "string",
      "pattern": "^C\\d{2,}$"
    },
    "edgeKind": {
      "enum": [
        "contains",
        "sequence",
        "causal",
        "dependency",
        "data-flow",
        "delegation",
        "association",
        "comparison",
        "conditional"
      ]
    },
    "sentence": {
      "type": "object",
      "required": [
        "text"
      ],
      "description": "설명 본문의 한 문장. 원문 근거(claims), 원문 밖 배경(context), 덧붙인 해석(inferences) 중 하나 이상을 가진다. 섞지 않는다.",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 2
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimId"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^K\\d{2,}$"
          }
        },
        "note": {
          "type": "string"
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^I\\d{2,}$"
          },
          "description": "이 스킬이 덧붙인 해석(INFERENCE/INTERPRETATION). 화면에 '해석' 라벨로 구분된다"
        }
      }
    }
  }
}
